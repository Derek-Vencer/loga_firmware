    rapidKeyEnable = false;
    keycodeOutput = false;
    while (timer_read() < (SampleTimer + samples*10))
    {
        for (uint8_t i = 0; i < ADC_NUM_CHANNELS; i++)
        {
            for (uint8_t j = 0; j < ADC_BUF_DEPTH; j++)
            {
