//                    setRunMode(currentLED_RunMode);
//                    //keycodeOutput = !keycodeOutput;
//                    resault = false;
//					break;

//				case KC_1:
//					for (uint16_t i=0;i<50;i++){
//					tap_code16(0x0014);
//					}
//					return false;
//					break;

//				case KC_UP:
//					rainbowBase++;
//					break;
//				case KC_DOWN:
