    }

    if (rapidTriggerKeyBuilder(true, 3, 1, 5, 5, keycodes) !=0){
    	uprintf ("build Fail #4\r\n");
    }

    if (rapidTriggerKeyBuilder(true, 4, 1, 6, 6, keycodes) !=0){
    	uprintf ("build Fail #5\r\n");
    }

    if (rapidTriggerKeyBuilder(true, 5, 1, 7, 7, keycodes) !=0){
